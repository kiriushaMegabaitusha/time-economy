# Time Economy Configuration
# Copy this file to .env and update values as needed

# Database URL (SQLite by default)
# DATABASE_URL=sqlite:///./time_economy.db

# Application settings
# APP_HOST=0.0.0.0
# APP_PORT=8000
# DEBUG=false

# Initial member credit
# INITIAL_CREDIT=5.0

# Credit limits
# CREDIT_CAP=20
# DEFICIT_LIMIT=-10
